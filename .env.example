# beehiiv — used for the waitlist signup API route (app/api/waitlist/route.ts)
# Create an API key:  beehiiv dashboard → Settings → Integrations → API
# Find the publication ID: Settings → Integrations → API (starts with "pub_")
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# SMTP — used for the contact form (app/api/contact/route.ts)
# Any SMTP provider works (Gmail, SendGrid, Mailgun, Postmark, etc.)
# Gmail example: host=smtp.gmail.com, port=587, user=you@gmail.com, pass=app-password
# SendGrid example: host=smtp.sendgrid.net, port=587, user=apikey, pass=<sendgrid-api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Meta (Facebook) Pixel — ad attribution, retargeting and campaign optimisation.
# Meta Events Manager → your pixel → Settings → Pixel ID (a ~15-digit number).
# NOT a secret: a pixel id is visible in the page source of every site using one,
# which is why it is NEXT_PUBLIC_.
#
# 🔴 LEAVE THIS BLANK UNTIL /privacy DISCLOSES THE TRACKING. With it unset the
# pixel renders nothing at all — no script, no cookie, no request to Meta. The
# policy said nothing about cookies, analytics or third-party tracking as of
# 2026-09-01, and this pixel does all three.
NEXT_PUBLIC_META_PIXEL_ID=
