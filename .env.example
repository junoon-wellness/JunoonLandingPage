# beehiiv — used for the waitlist signup API route (app/api/waitlist/route.ts)
# Create an API key:  beehiiv dashboard → Settings → Integrations → API
# Find the publication ID: Settings → Integrations → API (starts with "pub_")
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# SMTP — used for the contact form (app/api/contact/route.ts)
# Any SMTP provider works (Gmail, SendGrid, Mailgun, Postmark, etc.)
# Gmail example: host=smtp.gmail.com, port=587, user=you@gmail.com, pass=app-password
# SendGrid example: host=smtp.sendgrid.net, port=587, user=apikey, pass=<sendgrid-api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
